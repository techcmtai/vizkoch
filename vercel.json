{
  "rewrites": [
      {
        "source": "/(.*)",
        "destination": "/index.html"
      }
    ],
  
    "builds": [
      {
        "src": "server/index.ts",
        "use": "@vercel/node"
      },
      {
        "src": "dist/public/**/*",
        "use": "@vercel/static"
      }
    ],
    "routes": [
      {
        "src": "/api/(.*)",
        "dest": "server/index.ts"
      },
      {
        "src": "/(.*)",
        "dest": "/index.html"
      }
  
    ]
  }
    
  